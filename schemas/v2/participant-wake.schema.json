{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nunchi.invalid/schemas/v2/participant-wake.schema.json",
  "title": "ParticipantWakeV2",
  "description": "I-010C ParticipantWakeV2@5 — the materialized normal-turn or ACK effect facts. @5 adds memory.threads: recent messages the attention model judged to ask someone for something, and the participant's own messages that others responded to, each with the first messages that responded and what they said; memory now carries own_moves, threads, or both. @4 adds an optional memory: the participant's own recent moves in the room (its messages, replies, reactions and silences), each pointing at the message it was about. They are facts with pointers, never a verdict or an obligation, and old moves fade. @3 lets a DEFER wake carry the model's reading of the room, as a WAKE wake already could, and adds judged_through_event_id: the newest event the reading saw. @2 added ACK as an explicit source without a reading; ERROR_FALLBACK, PREATTENTION_BYPASS, exact identity/room/event facts, bounded coverage, and host-only continuation semantics remain unchanged. No admission meta-answer, composed reply, or work queue is part of the contract.",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "$comment": "PREATTENTION_BYPASS is a lifecycle fact, not a social judgment.",
          "enum": ["ACK", "WAKE", "DEFER", "ERROR_FALLBACK", "PREATTENTION_BYPASS"]
        },
        "advice": {
          "type": "array",
          "items": {"$ref": "https://nunchi.invalid/schemas/v2/attention-decision.schema.json#/$defs/attentionAdvice"}
        },
        "evidence_event_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "judged_through_event_id": {
          "$comment": "The newest event the reading saw; it must name an event in this wake (runtime-adapter-only).",
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "$comment": "WAKE and DEFER are turns the participant takes after a model judgment, so they may carry its reading. ACK is Nunchi's own effect, and ERROR_FALLBACK and PREATTENTION_BYPASS have no model judgment, so they carry none.",
          "if": {"required": ["source"], "properties": {"source": {"enum": ["WAKE", "DEFER"]}}},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["advice"]},
                {"required": ["evidence_event_ids"]},
                {"required": ["judged_through_event_id"]}
              ]
            }
          }
        },
        {
          "$comment": "judged_through_event_id dates a reading, so it appears only with one.",
          "if": {"required": ["judged_through_event_id"]},
          "then": {"required": ["advice"]}
        }
      ]
    },
    "memory": {
      "$comment": "The participant's memory of this room: its own recent moves, and the threads (@5), each oldest first. Pointers may name messages that have left the window.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "threads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "author_id", "text", "responses"],
            "properties": {
              "event_id": {"$ref": "#/$defs/nonEmptyString"},
              "author_id": {"$ref": "#/$defs/nonEmptyString"},
              "text": {"type": "string", "maxLength": 280},
              "addressed_to": {"enum": ["participant", "room", "someone_else", "nobody"]},
              "at": {"$ref": "#/$defs/nonEmptyString"},
              "responses": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["event_id", "author_id", "text"],
                  "properties": {
                    "event_id": {"$ref": "#/$defs/nonEmptyString"},
                    "author_id": {"$ref": "#/$defs/nonEmptyString"},
                    "text": {"type": "string", "maxLength": 280}
                  }
                }
              }
            }
          }
        },
        "own_moves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "event_id", "text"],
                "properties": {
                  "kind": {"const": "message"},
                  "event_id": {"$ref": "#/$defs/nonEmptyString"},
                  "text": {"type": "string", "maxLength": 280},
                  "at": {"$ref": "#/$defs/nonEmptyString"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "event_id", "about_event_id", "text"],
                "properties": {
                  "kind": {"const": "reply"},
                  "event_id": {"$ref": "#/$defs/nonEmptyString"},
                  "about_event_id": {"$ref": "#/$defs/nonEmptyString"},
                  "text": {"type": "string", "maxLength": 280},
                  "at": {"$ref": "#/$defs/nonEmptyString"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "event_id", "about_event_id", "reaction"],
                "properties": {
                  "kind": {"const": "reaction"},
                  "event_id": {"$ref": "#/$defs/nonEmptyString"},
                  "about_event_id": {"$ref": "#/$defs/nonEmptyString"},
                  "reaction": {"$ref": "#/$defs/nonEmptyString"},
                  "at": {"$ref": "#/$defs/nonEmptyString"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "about_event_id", "at"],
                "properties": {
                  "kind": {"const": "silence"},
                  "about_event_id": {"$ref": "#/$defs/nonEmptyString"},
                  "at": {"$ref": "#/$defs/nonEmptyString"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "self", "room", "actors", "events", "trigger_event_id", "coverage", "attention"],
  "properties": {
    "request_id": {"$ref": "#/$defs/nonEmptyString"},
    "self": {"$ref": "https://nunchi.invalid/schemas/v2/attention-request.schema.json#/$defs/self"},
    "room": {"$ref": "https://nunchi.invalid/schemas/v2/attention-request.schema.json#/$defs/room"},
    "actors": {"$ref": "https://nunchi.invalid/schemas/v2/attention-request.schema.json#/$defs/actorMap"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://nunchi.invalid/schemas/v2/attention-request.schema.json#/$defs/event"}
    },
    "trigger_event_id": {"$ref": "#/$defs/nonEmptyString"},
    "coverage": {"$ref": "https://nunchi.invalid/schemas/v2/attention-request.schema.json#/$defs/coverage"},
    "continuation": {"$ref": "https://nunchi.invalid/schemas/v2/attention-request.schema.json#/$defs/continuation"},
    "attention": {"$ref": "#/$defs/attention"},
    "memory": {"$ref": "#/$defs/memory"}
  }
}
