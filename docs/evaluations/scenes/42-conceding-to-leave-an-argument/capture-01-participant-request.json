      },
      {
        "author_id": "agent:hermes",
        "id": "e9",
        "mentioned_actor_ids": [],
        "mentions_room": false,
        "text": "Two sides of bread, filling in the middle. It doesn't stop being a sandwich because one edge is attached.",
